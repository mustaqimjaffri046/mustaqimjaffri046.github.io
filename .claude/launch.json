{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler", "pages", "dev", "dist",
        "--port", "8788",
        "--compatibility-date=2026-08-08"
      ],
      "port": 8788
    },
    {
      "name": "redirect-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8111", "--directory", "redirect-site"],
      "port": 8111,
      "autoPort": false
    }
  ]
}
